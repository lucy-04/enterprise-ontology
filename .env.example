# Copy to .env and fill in.  cp .env.example .env
#
# Every key this project will ever use is listed here, including for stages not
# built yet. That is deliberate (CLAUDE.md §14.2): adding an unused key today is
# free, conflicting on this file on Thursday is not.

# --- HydraDB ---------------------------------------------------------------
# Start the node with `just db-up`, then verify with `just db-check`.
HYDRA_URI=bolt://127.0.0.1:7687
HYDRA_USER=
HYDRA_PASSWORD=local-development-token-32-bytes
HYDRA_HTTP=http://127.0.0.1:8443
HYDRA_GRAPH=default
HYDRA_NAMESPACE=default
HYDRA_CELL_ID=cell-0
# Where the hydradb source checkout lives (for `just db-up`).
HYDRADB_DIR=../hydradb

# --- LLM (free tiers — see CLAUDE.md §7.2) ---------------------------------
# provider: gemini | groq | openrouter | ollama
# groq/openrouter/ollama all speak the OpenAI-compatible API; gemini uses google-genai.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=
# Bulk, low-stakes calls — only the optional prose extractor (B2) uses this.
LLM_MODEL_CHEAP=gemini-flash-lite-latest
# Entity adjudication, conflict adjudication, answer synthesis. The one that matters.
LLM_MODEL_STRONG=gemini-3.5-flash
# Configure a second provider to fail over to when the first hits its daily cap.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
# Hard ceiling on total calls per stage; the run stops rather than burning quota.
LLM_MAX_CALLS_EXTRACT=2000
LLM_MAX_CALLS_RESOLVE=500
LLM_MAX_CALLS_CONFLICT=300
LLM_MAX_CALLS_ANSWER=1200
LLM_REQUESTS_PER_MINUTE=10

# --- Benchmark scorer ------------------------------------------------------
# The EnterpriseRAG-Bench evaluator is itself an LLM judge and burns its own
# quota. Can be the same key, but budget for it separately.
EVAL_LLM_PROVIDER=gemini
EVAL_LLM_API_KEY=

# --- Paths -----------------------------------------------------------------
DATA_DIR=./data

# --- Memory-sensitive knobs (dev machine is an 8GB M1 — see PROGRESS.md) ---
# Raise these only on a machine with more RAM.
EMBED_BATCH=64
NORMALIZE_WORKERS=6
PARQUET_ROW_GROUP=20000
